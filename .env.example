# --- Telegram (required for BUY signals to be sent) ---
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get your numeric chat id from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# --- LLM debate engine (all optional) ---
# If none of these are set, the app auto-detects the local `claude` CLI
# (uses your Claude subscription, no API key needed). If that's not
# available either, it falls back to a deterministic rule-based engine
# that always works offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Force a specific engine: claude_code | anthropic | openai | deterministic
LLM_PROVIDER=

# --- App behaviour ---
BRAND=Nivesh Council
CONFIDENCE_THRESHOLD=7
AGENT_DELAY=0.35
# Scout shortlists this % of each cap-segment bucket (large/mid/small), rounded —
# e.g. 40% of 10 stocks = 4, 40% of 12 = 5. A non-empty bucket always gets at least 1.
SHORTLIST_PERCENT=40
PORT=5000

# --- Trade levels for BUY signals (formula-derived, never invented) ---
# stop_loss = entry - (entry * SL_PERCENT/100)
SL_PERCENT=3
# take_profit = entry + (entry - stop_loss) * RISK_REWARD_RATIO
RISK_REWARD_RATIO=2.5

# --- BUY signal audit logs (buy_logs/*.txt) ---
# Auto-deleted after this many days
BUY_LOG_RETENTION_DAYS=30

# --- Scheduled run (optional) ---
# When true, the app fires one run automatically every weekday at SCHEDULE_TIME
# (IST, 24h HH:MM) — no need to click Start agents yourself. Only takes effect
# when running via `python app.py` (not needed for demo/dev use).
SCHEDULE_ENABLED=false
SCHEDULE_TIME=09:20
# Which mode the scheduled run uses: demo | live | auto
SCHEDULE_MODE=auto